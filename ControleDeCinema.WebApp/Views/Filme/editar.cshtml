@model EditarFilmeViewModel
@{
    Layout = "_Layout";
    ViewBag.Title = "Edição de Filme";
}

<div class="row mt-3">
    <div class="col-lg-6">
        <form asp-action="Editar">
            <div class="mt-2">
                <label class="control-label">Filme:</label>
                <input class="form-control" asp-for="Titulo" />
                <span class="text-danger my-1" asp-validation-for="Titulo"></span>
            </div>

            <div class="mt-2">
                <label class="control-label">Genero:</label>
                <select class="form-select" asp-for="IdGenero" asp-items="Model.Generos">
                    <option></option>
                </select>
                <span class="text-danger my-1" asp-validation-for="IdGenero"></span>
            </div>

            <div class="mt-2">
                <label class="control-label">Duração:</label>
                <input type="number" class="form-control" asp-for="Duracao" />
                <span class="text-danger my-1" asp-validation-for="Duracao"></span>
            </div>

            <div class="form-check">
                <input class="form-check-input mb-1" asp-for="Lancamento"/>
                <label class="form-check-label fw-semibold mb-1">É Lançamento?</label>
                <span class="text-danger fs-6" asp-validation-for="Lancamento"></span>
            </div>

            <div class="mt-2">
                <button class="btn btn-primary">
                    <i class="bi bi-floppy-fill me-1"></i>
                    Gravar
                </button>
                <a href="/filme/listar" class="btn btn-info">Voltar</a>
            </div>
        </form>
    </div>
</div>
